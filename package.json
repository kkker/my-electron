{
  "name": "electron-react-vite-app",
  "version": "1.0.6",
  "description": "這是我的專案描述，不要留空，否則編譯日誌會噴 missed 警告",
  "author": {
    "name": "Author Name",
    "email": "author@myapp.com"
  },
  "main": "electron-main.js",
  "scripts": {
    "vite:start": "vite --host 0.0.0.0 --port 5173",
    "electron:start": "electron . --no-sandbox --disable-gpu",
    "dev": "concurrently \"npm run vite:start\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "build:react": "vite build",
    "build:electron": "electron-builder --linux",
    "build:win": "WINEPREFIX=/tmp/wine-prefix ELECTRON_BUILDER_CACHE=/tmp/electron-builder-cache electron-builder --win --x64",
    "package": "npm run build:react && npm run build:electron",
    "package:win": "npm run build:react && npm run build:win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "knex": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "MyDockerApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "db/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "contents": [
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" },
        { "x": 130, "y": 220, "type": "file" }
      ]
    },
    "win": {
      "publisherName": "Your Company Name",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyDockerApp"
    }
  }
}
