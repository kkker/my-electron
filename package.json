{
  "name": "electron-react-vite-app",
  "version": "1.0.0",
  "author": "Author Name <author@myapp.com>",
  "main": "electron-main.js",
  "scripts": {
    "vite:start": "vite --host 0.0.0.0 --port 5173",
    "electron:start": "NODE_ENV=development electron . --no-sandbox",
    "dev": "concurrently \"npm run vite:start\" \"wait-on http://localhost:5173 && npm run electron:start\"",
    "build:react": "vite build",
    "build:electron": "electron-builder --linux",
    "package": "npm run build:react && npm run build:electron"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.example.myapp",
    "productName": "MyDockerApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
